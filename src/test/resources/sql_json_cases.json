                "operator": ">=",
                "left": {
                  "type": "IDENTIFIER",
                  "name": "created_at"
                },
                "right": {
                  "type": "BINARY_OP",
                  "operator": "-",
                  "left": {
                    "type": "FUNCTION",
                    "functionName": "SYSDATE",
                    "arguments": []
                  },
                  "right": {
                    "type": "LITERAL",
                    "literalType": "NUMBER",
                    "value": 30
                  }
                }
              },
              "groupBy": {
                "items": [
                  {
                    "type": "IDENTIFIER",
                    "name": "user_id"
                  }
                ]
              }
            }
          }
        ],
        "selectList": [
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "au.id"
            }
          },
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "au.name"
            }
          },
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "ro.order_count"
            }
          }
        ],
        "from": {
          "type": "JOIN",
          "joinType": "LEFT",
          "left": {
            "type": "TABLE",
            "table": "active_users",
            "alias": "au"
          },
          "right": {
            "type": "TABLE",
            "table": "recent_orders",
            "alias": "ro"
          },
          "condition": {
            "type": "BINARY_OP",
            "operator": "=",
            "left": {
              "type": "IDENTIFIER",
