                "type": "BINARY_OP",
                "operator": "=",
                "left": {
                  "type": "IDENTIFIER",
                  "name": "status"
                },
                "right": {
                  "type": "LITERAL",
                  "literalType": "STRING",
                  "value": "ACTIVE"
                }
              }
            }
          },
          {
            "name": "recent_orders",
