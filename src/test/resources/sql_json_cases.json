  {
    "id": "select_join_group",
    "description": "多表JOIN + GROUP BY + HAVING + ORDER BY + LIMIT",
    "dbType": "mysql",
    "sql": "SELECT o.id, o.total_amount, u.name AS customer_name FROM orders o INNER JOIN users u ON o.user_id = u.id WHERE o.created_at >= '2024-01-01' GROUP BY o.id, o.total_amount, u.name HAVING SUM(o.total_amount) > 100 ORDER BY o.created_at DESC LIMIT 10",
    "json": {
      "type": "SELECT",
      "select": {
        "selectList": [
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "o.id"
            }
          },
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "o.total_amount"
            }
          },
          {
            "expr": {
              "type": "IDENTIFIER",
              "name": "u.name"
            },
            "alias": "customer_name"
          }
        ],
        "from": {
          "type": "JOIN",
          "joinType": "INNER",
          "left": {
            "type": "TABLE",
            "table": "orders",
            "alias": "o"
          },
          "right": {
            "type": "TABLE",
            "table": "users",
            "alias": "u"
          },
          "condition": {
            "type": "BINARY_OP",
            "operator": "=",
            "left": {
              "type": "IDENTIFIER",
              "name": "o.user_id"
            },
            "right": {
              "type": "IDENTIFIER",
              "name": "u.id"
            }
          }
        },
        "where": {
          "type": "BINARY_OP",
          "operator": ">=",
          "left": {
            "type": "IDENTIFIER",
            "name": "o.created_at"
          },
          "right": {
            "type": "LITERAL",
            "literalType": "STRING",
            "value": "2024-01-01"
          }
        },
        "groupBy": {
          "items": [
            {
              "type": "IDENTIFIER",
              "name": "o.id"
            },
            {
              "type": "IDENTIFIER",
              "name": "o.total_amount"
            },
            {
              "type": "IDENTIFIER",
              "name": "u.name"
            }
          ]
        },
        "having": {
          "type": "BINARY_OP",
          "operator": ">",
          "left": {
            "type": "FUNCTION",
            "functionName": "SUM",
            "arguments": [
              {
                "type": "IDENTIFIER",
                "name": "o.total_amount"
              }
            ]
          },
          "right": {
            "type": "LITERAL",
            "literalType": "NUMBER",
            "value": 100
          }
        },
        "orderBy": {
          "items": [
            {
              "expr": {
                "type": "IDENTIFIER",
                "name": "o.created_at"
              },
              "direction": "DESC"
            }
          ]
        },
        "limit": {
          "offset": 0,
          "rowCount": 10
        }
      }
    }
  },
