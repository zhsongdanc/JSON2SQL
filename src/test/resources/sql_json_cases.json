                {
                  "expr": {
                    "type": "IDENTIFIER",
                    "name": "user_id"
                  }
                },
                {
                  "expr": {
                    "type": "FUNCTION",
                    "functionName": "COUNT",
                    "arguments": [
                      {
                        "type": "LITERAL",
                        "literalType": "NUMBER",
                        "value": 1
                      }
                    ]
                  },
                  "alias": "order_count"
                }
              ],
              "from": {
                "type": "TABLE",
                "table": "orders"
              },
              "where": {
